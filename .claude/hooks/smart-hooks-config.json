{
  "version": "1.0.0",
  "hooks": {
    "PreToolUse": [
      {
        "name": "Validate command safety",
        "command": "node .claude/hooks/validate-command-safety.js",
        "enabled": true,
        "blocking": true,
        "timeout": 30,
        "alwaysRun": true
      },
      {
        "name": "Vital-file guard",
        "command": "node .claude/hooks/vital-file-guard.js",
        "enabled": true,
        "blocking": true,
        "timeout": 30,
        "alwaysRun": true
      },
      {
        "name": "Cross-worktree guard",
        "command": "node .claude/hooks/prevent-cross-worktree-writes.js",
        "enabled": true,
        "blocking": true,
        "timeout": 30,
        "alwaysRun": true
      }
    ],
    "Stop": [
      {
        "name": "Uncommitted worktree changes",
        "command": "node .claude/hooks/check-uncommitted.js",
        "enabled": true,
        "blocking": true,
        "timeout": 10
      },
      {
        "name": "Remind Playwright",
        "command": "node .claude/hooks/remind-playwright.js",
        "enabled": true,
        "blocking": true,
        "timeout": 10
      },
      {
        "name": "Remind Cleanup",
        "command": "node .claude/hooks/remind-cleanup.js",
        "enabled": true,
        "blocking": true,
        "timeout": 10,
        "alwaysRun": true
      },
      {
        "name": "Typecheck (edited packages only)",
        "command": "node .claude/hooks/scoped-typecheck.js",
        "filePatterns": [
          "packages/**/*.ts",
          "packages/**/*.tsx"
        ],
        "enabled": true,
        "blocking": true,
        "timeout": 300,
        "containerSkippable": true
      },
      {
        "name": "Vitest (edited files only)",
        "command": "node .claude/hooks/scoped-vitest.js",
        "filePatterns": [
          "packages/**/*.ts",
          "packages/**/*.tsx"
        ],
        "enabled": true,
        "blocking": true,
        "timeout": 300,
        "containerSkippable": true
      }
    ]
  }
}
