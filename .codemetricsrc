# Code-metrics config for agentic-kanban.
# Merged with the tool's built-in excludes (node_modules, dist, migrations/meta,
# lock/binary files, etc.). These patterns add the repo-specific noise.

[exclude]
patterns = [
  # Git worktrees — 25 full package-tree copies under packages/.worktrees/
  # that otherwise dominate the "root" bucket and double-count every file.
  "**/.worktrees/**",
  # Harness/workflow worktrees (full source-tree copies + node_modules) live under
  # .claude/worktrees/ — exclude so they don't double-count files / skew hotspots.
  ".claude/worktrees/**",
  "**/.claude/worktrees/**",
  # Generated Drizzle SQL migrations (built-in only drops drizzle/meta).
  "**/drizzle/**",
  # Logs (incl. multi-MB dev.log at the repo root — *.log needed for root files).
  "*.log",
  "**/*.log",
  # Tooling / scratch / agent dirs and test artifacts.
  ".tmp/**",
  ".llm/**",
  ".playwright/**",
  "**/test-results/**",
  "**/playwright-report/**",
  # Prose/spec dirs — churn here is doc activity, not code health.
  "docs/**",
  "openspec/**",
  ".changeset/**",
]

[analysis]
lizard_processes = 4
git_days = 90
top_findings = 30

[[modules]]
name = "client"
path = "packages/client"

# #795 — CUT A PACKAGE AT THE PACKAGE, NOT AT ITS src/.
#
# `shared` was cut at `packages/shared/src`, and it is the ONE package whose tests do not
# live under src/ — they are at `packages/shared/__tests__/`. So 102 of its files fell into
# the unassigned `root` bucket, and every module-scoped number this repo has ever produced
# (containment, entanglement, module distance, the DIP ratios, `relocate_file`) was computed
# over a `shared` missing a third of itself, next to a `root` pseudo-module that was 41% one
# package's test suite. Measured at ae295022e1: shared 219 files / root 246.
#
# `server` had the same class of miss, smaller: its bundled skill, plugin, bin-shim, tooling
# and generator files sit beside src/ (22 files), not in it.
#
# Cutting at the package directory is the rule now, for every package. The tool's built-in
# excludes plus the [exclude] block above already drop node_modules/, dist/, coverage/ and
# drizzle/, so "the package" means the package's own tracked source and tests.
[[modules]]
name = "server"
path = "packages/server"

[[modules]]
name = "shared"
path = "packages/shared"

[[modules]]
name = "mcp-server"
path = "packages/mcp-server"

[[modules]]
name = "e2e"
path = "packages/e2e"

# `desktop` deliberately stays at src-tauri: that subdirectory IS the Rust crate, and the
# rest of the package is a Tauri shell with no source of its own.
[[modules]]
name = "desktop"
path = "packages/desktop/src-tauri"

# #795 — root `scripts/` is 56 files of real build/dev/analysis tooling, and while it was
# unnamed it was aggregated into the `root` pseudo-module. The analyzer itself flags the
# root <-> server module cycle as an artifact of aggregating unassigned files, so anything
# that shrinks that bucket makes the cycle finding less fabricated.
[[modules]]
name = "scripts"
path = "scripts"

# #796 (follow-up to #742) — ARCHITECTURAL ROLE OVERRIDE FOR THE CLIENT'S PURE-LOGIC LAYER.
#
# The layer-fit signal infers a file's role from path convention, and its `frontend`
# rule matches `(?:^|/)client/` BEFORE any `service`/`model`/`domain` rule is tried
# (`_ROLE_RULES` in code-metrics `runners/layerfit_runner.py`, ordered
# view → frontend → controller → service → domain → model). So every one of the 633
# files under `packages/client/` scored role `frontend` = axis position 0.0, and the
# client's centre of gravity was pinned at exactly 0.000 by the package's NAME.
#
# That is a naming artifact, not a structural absence, and no refactor could move it:
# #742 was filed against the 0.000 and set "client CoG off 0.000" as its target, which
# was unattainable. Recording it here is what stops it being re-filed a fourth time.
#
# `packages/client/src/lib/` IS this client's domain layer, by an explicit repo decision
# (#589, enforced by `client-module-placement.test.ts` — "client/src grows no second home
# for pure logic"). Its branching mass is genuinely pure modules — transcript parsing,
# diff highlighting, route derivation, reducers, policies — not transport: `api.ts`, the
# one HTTP-shaped file, is not in the directory's top 20 by decision points.
#
# `infer_role()` consults these config patterns BEFORE the built-in conventions
# (fnmatch against the whole repo-relative path), so this override wins. Measured effect
# at 05b9e685e8 over 2,778 files, by re-running the runner with and without the block:
#
#   client centre of gravity   0.0000 -> 0.2041   (frontend 12,892 -> frontend 10,261 + domain 2,631)
#   overall centre of gravity  0.3481 -> 0.4342
#   logic_in_adapter_ratio     0.4628 -> 0.3766
#   layer leaks                1 -> 1   (unchanged: the lone `query_in_adapter` is
#                                        `ref.current?.select()` in ButlerChrome.tsx)
#
# The client CoG is now a number a refactor can actually move: extracting a testable rule
# out of `components/` into `lib/` raises it. Before this block it could not.
[roles]
domain = ["packages/client/src/lib/**"]
