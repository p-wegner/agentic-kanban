shamefully-hoist=false
strict-peer-dependencies=false
# append-only: no interactive progress redraw (low-noise for agents / PS 5.1) but a
# first `pnpm install` on a fresh clone still shows it is alive. Was reporter=silent,
# which made multi-minute cold installs look hung on new machines.
reporter=append-only
# Silence npm's "Unknown env config" warnings emitted when npm/npx run as a child of
# pnpm (pnpm exports its config as npm_config_* env vars; npm rejects the pnpm-only keys).
# That banner was the #1 PowerShell failure cluster (stderr noise flips PS 5.1 exit codes)
# and pure token noise on nearly every npm/npx call.
loglevel=error
only-built-dependencies[]=esbuild
# #1587: import packages by COPY, not hard link. On Windows a hard link of a native addon
# (@libsql/*/index.node) mapped by a running board/builder cannot be unlinked, so a re-install
# elsewhere failed ERR_PNPM_EPERM. pnpm has no per-package import method, so this is global.
package-import-method=copy
